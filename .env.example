# ============================================
# CYBERTRIP.UZ — Environment Configuration
# ============================================

# Application
NODE_ENV=development
APP_NAME=CyberTrip
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PREFIX=/api

# Database (PostgreSQL)
DATABASE_URL=postgresql://cybertrip:cybertrip_dev_2024@localhost:5432/cybertrip?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=change-this-to-a-secure-random-string-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
BCRYPT_ROUNDS=12

# Cookie
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Lab System
LAB_SESSION_TIMEOUT_MINUTES=60
LAB_MAX_CONCURRENT_SESSIONS=3

# Terminal
TERMINAL_SESSION_TIMEOUT_MINUTES=30
TERMINAL_MAX_CONCURRENT=5

# File Upload
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./uploads

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Admin
ADMIN_EMAIL=admin@cybertrip.uz
ADMIN_PASSWORD=CyberTrip2024!
